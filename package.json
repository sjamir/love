{
  "name": "where-is-the-love-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:final": "remotion render src/index.ts WhereIsTheLove output/where_is_the_love_final.mp4 --codec=h264 --audio-codec=aac --crf=16 --concurrency=4",
    "render:preview": "ffmpeg -y -i output/where_is_the_love_final.mp4 -vf scale=1280:720:flags=lanczos -c:v libx264 -crf 23 -preset medium -pix_fmt yuv420p -c:a copy output/where_is_the_love_preview.mp4",
    "render:draft": "remotion render src/index.ts WhereIsTheLove output/draft_960x540.mp4 --scale=0.5 --concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
